<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>sep-intrasisrvoe</artifactId>
        <groupId>mx.gob.sep</groupId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <name>sep-intrasisrvoe-seguridad</name>
    <artifactId>sep-intrasisrvoe-seguridad</artifactId>
    <groupId>mx.gob.sep</groupId>
    <packaging>jar</packaging>
    <url>http://maven.apache.org</url>
    <version>1.0.0-SNAPSHOT-seguridad</version>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <profiles>
        <profile>
            <id>desarrollo</id>
            <properties>
                <nombre-profile>desarrollo</nombre-profile>
                <modo-debug>debug</modo-debug>
            </properties>
        </profile>
        <profile>
            <id>local</id>
            <properties>
                <nombre-profile>local</nombre-profile>
                <modo-debug>debug</modo-debug>
            </properties>
        </profile>
        <profile>
            <id>nube</id>
            <properties>
                <nombre-profile>nube</nombre-profile>
                <modo-debug>debug</modo-debug>
            </properties>
        </profile>
        <profile>
            <id>testing</id>
            <properties>
                <nombre-profile>testing</nombre-profile>
                <modo-debug>debug</modo-debug>
            </properties>
        </profile>
        <profile>
            <id>dev</id>
            <properties>
                <nombre-profile>dev</nombre-profile>
                <modo-debug>debug</modo-debug>
            </properties>
        </profile>
        <profile>
            <id>produccion</id>
            <properties>
                <nombre-profile>produccion</nombre-profile>
                <modo-debug>error</modo-debug>
            </properties>
        </profile>
    </profiles>
    <repositories>
        <repository>
            <id>jahia</id>
            <name>jahia repo</name>
            <url>http://maven.jahia.org/maven2/</url>
        </repository>
    </repositories>
    <dependencies>
        <dependency>
            <groupId>commons-dbcp</groupId>
            <artifactId>commons-dbcp</artifactId>
            <version>1.4</version>
        </dependency>
        <dependency>
            <groupId>com.oracle</groupId>
            <artifactId>ojdbc6</artifactId>
            <version>12.1.0.2</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>org.springframework.jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>org.springframework.transaction</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>org.springframework.security.core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>org.springframework.security.config</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>org.springframework.security.acls</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>org.springframework.security.web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis</artifactId>
            <version>3.1.1</version>
        </dependency>
        <dependency>
            <groupId>net.sf.ehcache</groupId>
            <artifactId>ehcache</artifactId>
            <version>2.5.2</version>
            <type>pom</type>
        </dependency>
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis-spring</artifactId>
            <version>1.1.1</version>
            <exclusions>
                <exclusion>
                    <artifactId>spring-tx</artifactId>
                    <groupId>org.springframework</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>spring-core</artifactId>
                    <groupId>org.springframework</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>spring-context</artifactId>
                    <groupId>org.springframework</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>spring-jdbc</artifactId>
                    <groupId>org.springframework</groupId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
    <build>
        <resources>
            <resource>
                <filtering>true</filtering>
                <directory>src/main/resources</directory>
                <targetPath>.</targetPath>
            </resource>
        </resources>
    </build>
</project>
